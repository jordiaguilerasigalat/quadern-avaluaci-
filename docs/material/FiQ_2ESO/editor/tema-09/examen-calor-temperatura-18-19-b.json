":"auto","customLabel":"","children":[{"type":"subquestion","id":"f253b50c8","text":"alumini (C<sub>e</sub> = 890 J/Kg·K)","points":"","numMode":"auto","customLabel":"","children":[{"type":"spacer","id":"0e756409b","height":16}]},{"type":"subquestion","id":"a1a52c234","text":"acer (C<sub>e</sub> = 452 J/Kg·K)","points":"","numMode":"auto","customLabel":"","children":[{"type":"spacer","id":"3843a4bed","height":21}]}]},{"type":"question","id":"39fe69970","title":"","meta":"","text":"Tenim 120 g de gel a 253 K i els volem escalfar fins a 280 K.","points":"2","numMode":"auto","customLabel":"","children":[{"type":"subquestion","id":"cfbbe50c1","text":"Dibuixa un esquema del procés.","points":"","numMode":"auto","customLabel":"","children":[{"type":"spacer","id":"5468e4e11","height":36}]},{"type":"subquestion","id":"d738a8921","text":"Quina quantitat de calor necessitem aportar? <b><i>Ce</i></b> <i>(gel) = 2830 J/kg·K ;</i> <b><i>L</i></b> <i>(solidificació) = 334400 J/Kg ;</i> <b><i>Ce</i> </b><i>(aigua) = 4180 J/kg·K ;</i> <b><i>L</i></b><i>(vaporització) = 2248800</i> <i>J/Kg ,</i> <b><i>Ce</i> </b><i>(vapor aigua) = 1930 J/kg·K</i>","points":"","numMode":"auto","customLabel":"","children":[]}]}],"origen":"material"}