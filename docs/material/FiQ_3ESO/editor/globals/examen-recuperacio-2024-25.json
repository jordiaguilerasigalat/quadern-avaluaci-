ec447db1","height":21}]},{"type":"subquestion","id":"f4b5b223b","text":"0,25 kg/cm<sup>3</sup> a g/mm<sup>3</sup>","points":"","numMode":"auto","customLabel":"","children":[{"type":"spacer","id":"6a701dba6","height":25}]}]},{"type":"question","id":"49b694374","title":"","meta":"","text":"En la figura seguent es representa una xeringa amb una determinada quantitat de gas (nombre de molècules) i amb un èmbol en dues posicions diferents (A i B). La temperatura de la xeringa <b>A</b> es de 25 <sup>o</sup>C i la de la xeringa <b>B</b> és de 298 K. <b>Explica detalladament</b> quines de les seguents magnituds varien en aquestes dues situacions, és a dir, quan estirem l’èmbol:","points":"","numMode":"auto","customLabel":"","children":[{"type":"image","id":"552dc04f6","src":"data:image/jpeg;base64,","widthPct":24,"imgAlign":"center","caption":""},{"type":"text","id":"546b6dc5a","text":"La massa del gas:\nEl volum ocupat pel gas:\nLa densitat del gas:\nLa temperatura del gas:\nLa pressió del gas:","variant":"plain"},{"type":"spacer","id":"c9b5f0c09","height":25}]},{"type":"question","id":"2d44e1f9c","title":"","meta":"","text":"Volem refredar 100 g aigua des de 5 <sup>o</sup>C en estat líquid fins a -25 <sup>o</sup>C. <b>Dibuixa</b> el gràfic temperatura-temps d’aquest experiment, i calcula <b>quanta calor</b> hi ha involucrada en aquest procés?\n<i>Dades: c<sub>e</sub> (gas) = 1960 J/kg·K ; c<sub>e</sub> (líquid) = 4180 J/kg·K ; c<sub>e</sub> (sòlid) = 2050 J/kg · K</i> <i>L<sub>fus</sub> = 334400 J/kg ; L<sub>vap</sub> = 2248800 J/kg</i>","points":"","numMode":"auto","customLabel":"","children":[{"type":"spacer","id":"e8c6095c2","height":25}]},{"type":"question","id":"013480b09","title":"","meta":"","text":"En un got de precipitats tenim una mescla formada per níquel, arena, sal comú i àcid cítric (llimona). A la taula seguent pots trobar informació sobre la solubilitat d’aquestes substàncies en aigua i alcohol. Fes un <b>esquema</b> indicant com obtindries les substàncies pures aíllades i en forma sòlida.","points":"","numMode":"auto","customLabel":"","children":[{"type":"table","id":"760c70a1e","table":{"header":true,"border":"grid","zebra":false,"hshade":true,"rowH":0,"widths":["19","19","19","21","21"],"cells":[["","Arena","Sal comú","Àcid cítric","Níquel"],["Aigua","insoluble","soluble","soluble","insoluble"],["Etanol","insoluble","insoluble","soluble","insoluble"],["Magnètic","No","No","No","Sí"]]}},{"type":"spacer","id":"f37ec6201","height":25}]},{"type":"question","id":"fa2b43b85","title":"","meta":"","text":"A partir de la seguent imatge <b>indica</b>:","points":"","numMode":"auto","customLabel":"","children":[{"type":"image","id":"eb30c759c","src":"data:image/jpeg;base64,","widthPct":32,"imgAlign":"center","caption":""},{"type":"text","id":"71638a3cb","text":"Nombre d’electrons: Nombre de protons: Nombre de neutrons: Nombre de nucleons: Nombre atòmic: Nombre màssic: Càrrega de l’àtom: Posició en la taula periòdica (grup i període):","variant":"plain"},{"type":"spacer","id":"39eafdb98","height":25}]},{"type":"question","id":"db1c486c2","title":"","meta":"","text":"Si un got conté <b>200 grams</b> d’aigua<b>,</b> calcula:","points":"","numMode":"auto","customLabel":"","children":[{"type":"subquestion","id":"c6b1ca2be","text":"El nombre de <b>mols d’aigua</b>","points":"","numMode":"auto","customLabel":"","children":[{"type":"spacer","id":"257eca7c4","height":36}]},{"type":"subquestion","id":"376b7c3c4","text":"El nombre de <b>molècules d’aigua</b>","points":"","numMode":"auto","customLabel":"","children":[{"type":"spacer","id":"6d77fca92","height":36}]},{"type":"subquestion","id":"0a5eb689e","text":"El nombre d’<b>àtoms totals</b>","points":"","numMode":"auto","customLabel":"","children":[{"type":"spacer","id":"9808066c5","height":36}]},{"type":"subquestion","id":"3d83c54a6","text":"El nombre d’<b>àtoms d’hidrogen</b>","points":"","numMode":"auto","customLabel":"","children":[]}]}],"origen":"material"}